# Node / bridge
node_modules/
dist/
*.tsbuildinfo

# Rust build output (api/) — Cargo.lock IS committed, target/ is not
api/target/

# Playground
playground/

# Env / secrets
.env
.env.*
!.env.example
# Compose's auth/env channels: devbox overrides carry provider tokens
# (ANTHROPIC_AUTH_TOKEN, --env values), the --env-file interpolations carry
# S3/DB creds — and TALARIA_DEVBOX_HOME can relocate the devbox tree into a
# checkout, so the bare patterns (any depth) are the guard. Docker's
# conventional override names ride along.
compose.env
compose.override.yml
docker-compose.override.yml

# Key material — an accidentally copied private key must not stage silently
*.pem
*.key
*.p12
*.pfx
id_rsa*


# Python plugin
__pycache__/
*.pyc

# Vendored upstreams for local builds (e.g. mission-control source) — not part of Talaria
vendor/

# OS / editor
.DS_Store
*.swp

# Fleet manifest (agent gateways + per-agent keys) — never commit
stack/fleet.json
fleet.json

# Rendered fleet (talaria-managed agent configs + compose) — never committed
/fleet/

# uploaded attachments (served from /api/uploads)
ui/.uploads/
.uploads/

# Reference repos studied but not vendored
.reference/
.inspect/
ui/.tanstack/

# Vite dep-optimizer cache (created when the dev server runs from ui/)
ui/.vite/

# OMC agent state (never commit)
.omc/
ui/.omc/

# Rendered per install from docker/searxng/settings.template.yml (holds the
# generated SEARXNG_SECRET).
docker/searxng/settings.local.yml

# Client POC apps — true subrepos with their own history (see apps/leadworks/README.md).
# Gitignore does not affect the build-time apps glob; the apps compile and run
# in dev while staying out of this repo's history.
apps/leadworks/
apps/waypoint/

# The in-app updater: the restart helper lives and logs here.
logs/
ui/dist-next/
ui/dist-prev/
