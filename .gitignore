# Node / bridge
node_modules/
dist/
*.tsbuildinfo

# Playground
playground/

# Env / secrets
.env
.env.*
!.env.example

# Python plugin
__pycache__/
*.pyc

# Vendored upstreams for local builds (e.g. mission-control source) — not part of Talaria
vendor/

# OS / editor
.DS_Store
*.swp

# Fleet manifest (agent gateways + per-agent keys) — never commit
stack/fleet.json
fleet.json

# Rendered fleet (talaria-managed agent configs + compose) — never committed
/fleet/

# uploaded attachments (served from /api/uploads)
ui/.uploads/
.uploads/

# Reference repos studied but not vendored
.reference/
.inspect/
ui/.tanstack/

# Vite dep-optimizer cache (created when the dev server runs from ui/)
ui/.vite/

# OMC agent state (never commit)
.omc/
ui/.omc/

# Rendered per install from docker/searxng/settings.template.yml (holds the
# generated SEARXNG_SECRET).
docker/searxng/settings.local.yml

# Client POC app — true subrepo with its own history (see apps/leadworks/README.md).
# Gitignore does not affect the build-time apps glob; the app compiles and runs
# in dev while staying out of this repo's history.
apps/leadworks/

# The in-app updater: the restart helper lives and logs here.
logs/
ui/dist-next/
ui/dist-prev/
