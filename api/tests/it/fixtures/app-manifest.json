{
  "about": [
    "The ONE judgement of an app's talaria.json, asserted by both hosts: Rust's talaria-app-manifest",
    "(validate_manifest, satisfies, SDK_VERSION) and the TS host's ui/src/server/app-build/manifest.ts",
    "(validateManifest, satisfiesRange, SDK_VERSION). Install and update refuse a manifest that fails,",
    "with the error; discovery lists an installed one as broken, still removable. `error` is a substring",
    "both sides' sentence must contain; `parsed` is what a passing manifest reads as. The published shape",
    "is docs/sdk/talaria.schema.json. sdkVersion is the version of @talaria/sdk this host provides."
  ],
  "sdkVersion": "1.0.0",
  "manifests": [
    {
      "about": "the minimal manifest: a name",
      "manifest": { "name": "Plain" },
      "parsed": { "name": "Plain", "icon": "⬡", "version": "0.0.0", "surfaces": [] }
    },
    {
      "about": "the documented manifest",
      "manifest": {
        "$schema": "https://example.com/talaria.schema.json",
        "name": "Contacts",
        "icon": "☏",
        "version": "0.1.0",
        "description": "Lightweight CRM.",
        "surfaces": { "work": "Contacts", "manage": "Contacts data", "settings": "Contacts" }
      },
      "parsed": { "name": "Contacts", "icon": "☏", "version": "0.1.0", "surfaces": ["work", "manage", "settings"] }
    },
    {
      "about": "a declared slug, an sdk range this host meets, and the reserved keys",
      "manifest": {
        "name": "Field notes",
        "slug": "field-notes",
        "sdk": "^1.0",
        "surfaces": { "work": "Field notes" },
        "harnesses": [],
        "triggers": [{ "id": "nightly", "cron": "0 3 * * *" }, { "id": "on-ticket", "event": "ticket.created" }]
      },
      "parsed": { "name": "Field notes", "slug": "field-notes", "icon": "⬡", "version": "0.0.0", "surfaces": ["work"] }
    },
    {
      "about": "unknown top-level keys are ignored, so a newer manifest still reads",
      "manifest": { "name": "Later", "homepage": "https://example.com", "license": "MIT" },
      "parsed": { "name": "Later", "icon": "⬡", "version": "0.0.0", "surfaces": [] }
    },
    {
      "about": "an empty icon or version falls back to the default",
      "manifest": { "name": "Bare", "icon": "", "version": "" },
      "parsed": { "name": "Bare", "icon": "⬡", "version": "0.0.0", "surfaces": [] }
    },
    { "about": "not an object", "manifest": ["name"], "error": "must be a JSON object" },
    { "about": "no name", "manifest": { "surfaces": { "work": "X" } }, "error": "needs a \"name\"" },
    { "about": "a blank name", "manifest": { "name": "   " }, "error": "needs a \"name\"" },
    { "about": "a name that is not a string", "manifest": { "name": 7 }, "error": "needs a \"name\"" },
    {
      "about": "a name over the cap",
      "manifest": { "name": "nnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnn" },
      "error": "\"name\" is longer than 120 characters"
    },
    { "about": "a slug that breaks the rule", "manifest": { "name": "X", "slug": "Big App" }, "error": "\"slug\": \"Big App\" is not a usable app slug" },
    { "about": "a reserved slug", "manifest": { "name": "X", "slug": "meta" }, "error": "is reserved" },
    { "about": "a slug that is not a string", "manifest": { "name": "X", "slug": 3 }, "error": "\"slug\" must be a string" },
    { "about": "an icon that is not a string", "manifest": { "name": "X", "icon": 1 }, "error": "\"icon\" must be a string" },
    { "about": "a description that is not a string", "manifest": { "name": "X", "description": ["a"] }, "error": "\"description\" must be a string" },
    { "about": "surfaces that are not an object", "manifest": { "name": "X", "surfaces": ["work"] }, "error": "\"surfaces\" must be an object" },
    { "about": "an unknown surface", "manifest": { "name": "X", "surfaces": { "dashboard": "X" } }, "error": "unknown surface \"dashboard\"" },
    { "about": "a surface title that is not a string", "manifest": { "name": "X", "surfaces": { "work": true } }, "error": "\"surfaces.work\" must be a non-empty string" },
    { "about": "an empty surface title", "manifest": { "name": "X", "surfaces": { "manage": "" } }, "error": "\"surfaces.manage\" must be a non-empty string" },
    { "about": "an sdk range this host is outside of", "manifest": { "name": "X", "sdk": "^2.0" }, "error": "this app needs @talaria/sdk ^2.0; this host provides 1.0.0" },
    { "about": "an sdk value that is not a range", "manifest": { "name": "X", "sdk": "latest" }, "error": "\"sdk\" is not a version range" },
    { "about": "an sdk value that is not a string", "manifest": { "name": "X", "sdk": 1 }, "error": "\"sdk\" must be a string" },
    { "about": "harnesses of the wrong shape", "manifest": { "name": "X", "harnesses": "all" }, "error": "\"harnesses\" must be an array or an object" },
    { "about": "triggers that are not a list", "manifest": { "name": "X", "triggers": {} }, "error": "\"triggers\" must be an array" },
    { "about": "a trigger without an id", "manifest": { "name": "X", "triggers": [{ "cron": "* * * * *" }] }, "error": "\"triggers[0].id\"" },
    { "about": "a trigger with both cron and event", "manifest": { "name": "X", "triggers": [{ "id": "a", "cron": "* * * * *", "event": "x" }] }, "error": "exactly one of \"cron\" or \"event\"" },
    { "about": "a trigger with neither", "manifest": { "name": "X", "triggers": [{ "id": "a" }] }, "error": "exactly one of \"cron\" or \"event\"" }
  ],
  "ranges": [
    { "range": "*", "version": "1.0.0", "satisfied": true },
    { "range": "", "version": "1.0.0", "satisfied": true },
    { "range": "1.x", "version": "1.4.2", "satisfied": true },
    { "range": "1.x", "version": "2.0.0", "satisfied": false },
    { "range": "1", "version": "1.9.9", "satisfied": true },
    { "range": "1.2", "version": "1.2.9", "satisfied": true },
    { "range": "1.2", "version": "1.3.0", "satisfied": false },
    { "range": "1.2.3", "version": "1.2.3", "satisfied": true },
    { "range": "=1.2.3", "version": "1.2.4", "satisfied": false },
    { "range": "^1.2.3", "version": "1.9.0", "satisfied": true },
    { "range": "^1.2.3", "version": "1.2.2", "satisfied": false },
    { "range": "^1.2.3", "version": "2.0.0", "satisfied": false },
    { "range": "^1.0", "version": "1.0.0", "satisfied": true },
    { "range": "^1", "version": "1.99.0", "satisfied": true },
    { "range": "^0.2.3", "version": "0.2.9", "satisfied": true },
    { "range": "^0.2.3", "version": "0.3.0", "satisfied": false },
    { "range": "^0.0.3", "version": "0.0.3", "satisfied": true },
    { "range": "^0.0.3", "version": "0.0.4", "satisfied": false },
    { "range": "^0.2", "version": "0.2.5", "satisfied": true },
    { "range": "^0.2", "version": "0.3.0", "satisfied": false },
    { "range": "~1.2.3", "version": "1.2.9", "satisfied": true },
    { "range": "~1.2.3", "version": "1.3.0", "satisfied": false },
    { "range": "~1", "version": "1.5.0", "satisfied": true },
    { "range": ">=1.0.0 <2", "version": "1.5.0", "satisfied": true },
    { "range": ">=1.0.0 <2", "version": "2.0.0", "satisfied": false },
    { "range": ">= 1.2 < 1.4", "version": "1.3.7", "satisfied": true },
    { "range": ">1.2", "version": "1.2.9", "satisfied": false },
    { "range": ">1.2", "version": "1.3.0", "satisfied": true },
    { "range": ">1.2.3", "version": "1.2.4", "satisfied": true },
    { "range": ">1", "version": "1.9.0", "satisfied": false },
    { "range": "<=1.2", "version": "1.2.9", "satisfied": true },
    { "range": "<=1.2", "version": "1.3.0", "satisfied": false },
    { "range": "<=1.2.3", "version": "1.2.3", "satisfied": true },
    { "range": "<1.2", "version": "1.1.9", "satisfied": true },
    { "range": "<1.2", "version": "1.2.0", "satisfied": false },
    { "range": "^2 || ^1.0", "version": "1.0.0", "satisfied": true },
    { "range": "^2 || ^3", "version": "1.0.0", "satisfied": false },
    { "range": "latest", "version": "1.0.0", "error": "is not a version" },
    { "range": "^1.0.0-beta.1", "version": "1.0.0", "error": "pre-release" },
    { "range": "1.0.0 - 2.0.0", "version": "1.0.0", "error": "hyphen ranges" },
    { "range": "1.x.3", "version": "1.0.0", "error": "cannot follow a wildcard" },
    { "range": ">=", "version": "1.0.0", "error": "needs a version" },
    { "range": "<*", "version": "1.0.0", "error": "admits no version" },
    { "range": "1.2.3.4", "version": "1.0.0", "error": "is not a version" }
  ]
}
