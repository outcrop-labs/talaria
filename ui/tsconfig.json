{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": false,
    "noEmit": true,
    "types": ["node", "vite/client", "svelte"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@talaria/sdk": ["./src/sdk/index.ts"],
      "@talaria/sdk/server": ["./src/sdk/server.ts"]
    }
  },
  "include": ["src", "vite.config.ts", "vite.server.config.ts", "../apps"]
}
