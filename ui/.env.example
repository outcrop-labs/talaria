# ── Talaria UI — configuration ───────────────────────────────────────────────
# Copy to .env and fill in.

# The Talaria gateway plane (fleet multiplexer): /v1/models + model-routed chat.
# The UI's server routes proxy here (auth-gated), so the fleet URLs/keys never
# reach the browser. Unset ⇒ the chat runs in offline "mock" mode.
TALARIA_GATEWAY_URL=http://127.0.0.1:8642

# Key agents present (x-api-key / Bearer) to register + heartbeat to Talaria's
# own brain (POST /api/agents/register, GET /api/agents/:id/heartbeat). Point the
# Talaria plugin's base URL at this UI and its key here to report to Talaria
# instead of mission-control. Generate: openssl rand -hex 24
TALARIA_AGENT_KEY=

# ── State ────────────────────────────────────────────────────────────────────
# Postgres — durable state (users, roles, per-agent access, conversations,
# messages). Redis — sessions + ephemeral state.
DATABASE_URL=postgres://talaria:talaria@127.0.0.1:5544/talaria
REDIS_URL=redis://127.0.0.1:6399

# Where uploaded files land in local mode (default: <cwd>/.uploads). Admin →
# Storage can instead use the built-in bucket (the bundled talaria-minio
# container) or any external S3-compatible bucket (AWS S3, Backblaze B2,
# Cloudflare R2, MinIO) — that config lives in the DB, not here.
# TALARIA_UPLOADS_DIR=/var/lib/talaria/uploads

# Built-in bucket creds — must match the minio container's (dev.sh exports
# these for compose; both sides share the same defaults when unset).
# TALARIA_S3_ACCESS_KEY=talaria
# TALARIA_S3_SECRET_KEY=talaria-dev-secret
# TALARIA_S3_URL=http://127.0.0.1:9010
# TALARIA_S3_BUCKET=talaria

# ── Auth ─────────────────────────────────────────────────────────────────────
# Every provider is independently enable-able: a provider only appears on the
# login screen when its flag is on AND its required secrets are present.

# Admins (comma-separated emails). Everyone else who signs in (and passes the
# AUTH_ALLOWED_* gates) becomes a member.
AUTH_ADMIN_EMAILS=jon@packledger.co

# ─────────────────────────────────────────────────────────────────────────────
# ENCRYPTION ROOT (KEK) — the most important value in this file.
#
# Every provider API key, agent secret, OAuth token and storage credential in
# the database is sealed with a data key that is itself wrapped with THIS value.
# Change it and none of them can be decrypted again — there is no recovery path,
# because the plaintext only ever existed here.
#
# SET IT, and keep it stable for the life of the database. Back it up with the
# database: a dump without this value restores to a instance that cannot read
# its own secrets. Generate with: openssl rand -base64 48
#
# If it is blank, AUTH_SECRET below is used instead — which is why AUTH_SECRET
# is NOT safe to rotate on an instance that never set this. See docs/ENCRYPTION.md.
TALARIA_SECRET_KEY=
# Or point at a file instead (Docker/Kubernetes secrets):
# TALARIA_SECRET_KEY_FILE=/run/secrets/talaria_secret_key

# Signs the OAuth state cookie. Sessions are Redis-backed, so this is not
# required for sign-in — BUT if TALARIA_SECRET_KEY above is blank, this value
# is silently doing that job too, and rotating it destroys every stored secret.
# Set TALARIA_SECRET_KEY and this becomes genuinely safe to rotate.
# Generate with: openssl rand -base64 48
AUTH_SECRET=

# Optional — external origin used to build OAuth redirect URIs. Leave blank to
# derive from the request (honours X-Forwarded-Proto/Host behind a proxy).
# AUTH_PUBLIC_URL=https://talaria.packledger.co

# Optional global allow-list (applies to every provider). Leave both blank to
# allow anyone who authenticates.
# AUTH_ALLOWED_DOMAINS=getboxie.com,packledger.co
# AUTH_ALLOWED_EMAILS=jon@getboxie.com

# ── Provider: Google OAuth ────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI:  <origin>/api/auth/google/callback
AUTH_GOOGLE_ENABLED=1
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
# Optional — restrict to a Google Workspace domain.
# AUTH_GOOGLE_HD=getboxie.com

# ── Provider: Username / password ─────────────────────────────────────────────
# MVP stores users as "user:pass" pairs (comma-separated). Plaintext for now —
# hashing (bcrypt/argon2) is on the TODO list. Disable by leaving this off.
# AUTH_PASSWORD_ENABLED=1
# AUTH_USERS=jon@getboxie.com:change-me,ops:another-pass

# Live web search — Talaria's own `web_search` tool talks to SearXNG's JSON API.
# docker/dev-compose.yml runs one on 8888 with JSON enabled and the rate limiter
# off; point this at an instance you already run to use that one instead.
SEARXNG_URL=http://127.0.0.1:8888

# ── Outbound fetch policy (server/safe-fetch.ts) ──────────────────────────────
# Every URL that came from a user, an agent, a DB row or an upstream server's
# own response — MCP servers, OAuth discovery, app catalogs, favicons — is
# resolved and refused if it lands on a loopback / private / link-local address.
# Talaria's OWN infrastructure (Qdrant, the embedder, object storage, the
# built-in toolkit, admin-registered LLM endpoints) is exempt by design: those
# URLs come from you, not from input, and they legitimately point at localhost.
#
# This is the escape hatch for user-configurable targets that really do live on
# your network — a self-hosted MCP server on the LAN, say. It WIDENS what the
# server may reach, so treat a change here as a security decision. Comma or
# space separated; each entry is a host (mcp.corp.example), a host suffix
# (*.corp.example), an address (127.0.0.1), or a CIDR (10.42.0.0/16).
# TALARIA_FETCH_ALLOW_HOSTS=

# ── Rate limiting (server/rate-limit.ts) ──────────────────────────────────────
# X-Forwarded-For is caller-supplied, so the login limiter only honours it when
# you state that a proxy really is in front. Leave this unset when Talaria is
# reached directly: the per-IP counter then collapses to one bucket (deliberate
# — a wrong IP is worse than no IP, because it partitions the counter per
# attacker-chosen value) and the per-username counter does the real work.
# TALARIA_TRUST_PROXY=1
