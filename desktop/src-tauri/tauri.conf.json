{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Talaria",
  "version": "0.1.0",
  "identifier": "app.talaria.desktop",
  "build": {
    "beforeDevCommand": "bun run dev:vite",
    "devUrl": "http://localhost:5290",
    "beforeBuildCommand": "bun run build:vite",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Talaria",
        "width": 1280,
        "height": 800,
        "minWidth": 760,
        "minHeight": 600,
        "decorations": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Outcrop Labs",
    "copyright": "Copyright © 2026 Outcrop Labs LLC",
    "homepage": "https://github.com/outcrop-labs/talaria",
    "license": "MIT",
    "licenseFile": "../../LICENSE",
    "category": "Utility",
    "shortDescription": "A multitenant shell around Talaria instances",
    "longDescription": "Talaria Desktop is a launcher around hosted Talaria instances: add an instance by URL, switch between them in a click, and each instance keeps its own saved session."
  }
}
