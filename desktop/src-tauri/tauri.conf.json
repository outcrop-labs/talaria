{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Talaria",
  "version": "0.1.0",
  "identifier": "app.talaria.desktop",
  "build": {
    "beforeDevCommand": "bun run dev:vite",
    "devUrl": "http://localhost:5290",
    "beforeBuildCommand": "bun run build:vite",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Talaria",
        "width": 1280,
        "height": 800,
        "minWidth": 760,
        "minHeight": 600,
        "decorations": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"]
  }
}
