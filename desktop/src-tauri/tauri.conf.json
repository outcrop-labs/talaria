{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Talaria",
  "version": "0.1.0",
  "identifier": "app.talaria.desktop",
  "build": {
    "beforeDevCommand": "bun run dev:vite",
    "devUrl": "http://localhost:5290",
    "beforeBuildCommand": "bun run build:vite",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Talaria",
        "width": 1280,
        "height": 800,
        "minWidth": 760,
        "minHeight": 600,
        "decorations": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Outcrop Labs",
    "copyright": "Copyright © 2026 Outcrop Labs LLC",
    "homepage": "https://talariaworks.ai",
    "license": "MIT",
    "licenseFile": "../../LICENSE",
    "category": "Utility",
    "shortDescription": "Official desktop client for Talaria",
    "longDescription": "This is the official desktop client for Talaria. One workspace where the whole day actually happens: chat, boards, docs, plans, research. Agents work as real teammates, in your channels and on your tickets. Add a hosted or self-hosted instance by URL. Switch in a click. https://talariaworks.ai"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE3RTRFMzE4MEVEMEY3MjcKUldRbjk5QU9HT1BrcCtLbUVDTC9EVUV5Snk5a3hhMk9hcXRvMHQyWWhEcDB0cTA4RFhhOEdNdy8K",
      "endpoints": [
        "https://github.com/outcrop-labs/talaria/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
