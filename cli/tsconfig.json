{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["bun", "node"]
  },
  // bin/ and the tests are typechecked too — the tests exercise the same
  // Ctx-injected code paths CI runs.
  "include": ["src", "bin"]
}
