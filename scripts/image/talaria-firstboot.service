# Baked into the golden image by scripts/image/build.sh and ENABLED there
# (scripts/image/provision.sh stage 2) — so every clone provisions itself on
# first boot, snippet or not; a clone with no /etc/talaria.env just installs
# with defaults. Enabling it in the image rather than per-snippet means no
# snippet can forget to.
#
# The Condition is the once-guard: firstboot.sh writes the marker as its LAST
# successful act. Re-run an instance's install by deleting the marker (or
# `systemctl start talaria-firstboot`).

[Unit]
Description=Talaria first-boot install (clone, setup, build, app unit)
# cloud-init's write_files stage must have placed /etc/talaria.env (if the
# instance was given one) before the script reads it — hence cloud-final.
After=network-online.target docker.service cloud-final.service
Wants=network-online.target
ConditionPathExists=!/var/lib/talaria/firstboot-done
# A first install pulls images and builds for many minutes; retries (below)
# can span a settling network. Never let a rate limit or the 90s oneshot
# timeout decide this unit's fate.
StartLimitIntervalSec=0

[Service]
Type=oneshot
# The steering vars (TS_AUTHKEY, TALARIA_REPO, TALARIA_REF) are read by the
# script itself, before the app unit exists — so it needs the file too, not
# just talaria.service.
EnvironmentFile=-/etc/talaria.env
ExecStart=/usr/bin/bash /etc/talaria/firstboot.sh
# First boot races DNS, DHCP and the docker daemon. Every step of the install
# is idempotent, so retrying converges instead of wedging — but only if we
# actually retry.
Restart=on-failure
RestartSec=30
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
